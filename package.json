{
  "name": "frontend-stt",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint",
    "test": "playwright test",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:api": "playwright test tests/api.integration.spec.ts",
    "test:e2e": "playwright test tests/browser.journey.spec.ts tests/visual.states.spec.ts",
    "test:all": "npm run test:unit && npm run test:api && npm run test:e2e && npm run test:coverage"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "27.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "7.3.7",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.12"
  }
}
